{
  "name": "piying-subtitle-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "非遗皮影戏唱本-录音自动对齐与双语字幕工作台",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:samples": "tsx scripts/generate-samples.ts",
    "verify:align": "tsx scripts/verify-alignment.ts",
    "selftest": "npm run gen:samples && npm run verify:align",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^25.19.0",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
